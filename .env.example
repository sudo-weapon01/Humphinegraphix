# ---------------------------------------------------------------------------
# Humphinegraphix — environment variables
# Copy to `.env.local` for local development, and add the same keys in your
# host's dashboard (Vercel → Project → Settings → Environment Variables).
# ---------------------------------------------------------------------------

# --- Admin sign-in (PLACEHOLDER_ADMIN_CREDENTIALS) --------------------------
# Required in production. Without these, sign-in is disabled in production and
# a development-only demo login is used locally (studio / humphine-demo).
ADMIN_USERNAME=studio
ADMIN_PASSWORD=replace-with-a-long-random-password

# Signs the staff session cookie. Use at least 16 random characters.
# Generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET=replace-with-a-32-character-random-secret

# --- Content storage (optional) --------------------------------------------
# Leave these blank to use the local JSON store (.data/content.json) — perfect
# for local development and previews. Set both for production so content edits
# persist across deploys. Run supabase/schema.sql once in the SQL editor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Public site ------------------------------------------------------------
# Used for canonical URLs, Open Graph, and the sitemap.
NEXT_PUBLIC_SITE_URL=https://humphinegraphix.com
